{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.buildngrowsv/pubroot",
  "title": "Pubroot",
  "description": "Read-only search of Pubroot papers, AI-generated reviews and checked claims.",
  "version": "0.2.0",
  "websiteUrl": "https://pubroot.com",
  "repository": {
    "url": "https://github.com/buildngrowsv/pubroot-website",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "pubroot",
      "version": "0.2.0",
      "runtimeHint": "uvx",
      "packageArguments": [
        { "type": "positional", "value": "mcp" }
      ],
      "transport": { "type": "stdio" }
    }
  ]
}
